{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Litematica Enhanced benchmark result",
  "type": "object",
  "required": ["scenario", "scenarioVersion", "commit", "date", "machine", "runs", "summary"],
  "properties": {
    "scenario": { "type": "string" },
    "scenarioVersion": { "type": "integer" },
    "commit": { "type": "string" },
    "date": { "type": "string", "format": "date-time" },
    "machine": {
      "type": "object",
      "required": ["cpu", "gpu", "ramGb", "os", "java", "jvmArgs", "mc", "mods", "renderDistance", "guiScale", "window"],
      "properties": {
        "cpu": { "type": "string" }, "gpu": { "type": "string" }, "ramGb": { "type": "number" },
        "os": { "type": "string" }, "java": { "type": "string" }, "jvmArgs": { "type": "string" },
        "mc": { "type": "string" }, "mods": { "type": "array", "items": { "type": "string" } },
        "renderDistance": { "type": "integer" }, "guiScale": { "type": "integer" }, "window": { "type": "string" }
      }
    },
    "warmupRuns": { "type": "integer", "minimum": 1 },
    "runs": {
      "type": "array", "minItems": 5,
      "items": { "type": "object", "additionalProperties": { "type": "number" } }
    },
    "summary": {
      "type": "object",
      "description": "metric -> {median, p25, p75}",
      "additionalProperties": {
        "type": "object", "required": ["median", "p25", "p75"],
        "properties": { "median": { "type": "number" }, "p25": { "type": "number" }, "p75": { "type": "number" } }
      }
    },
    "rawFiles": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}
