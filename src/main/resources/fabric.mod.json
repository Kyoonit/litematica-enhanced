{
    "schemaVersion": 1,
    "id": "litematica",
    "name": "Litematica",
    "version": "${mod_version}",
    "description": "A modern schematic mod for LiteLoader, Rift, Fabric etc. (unofficial fork)",
    "authors": [
        "masa"
    ],
    "contributors": [
        "Sakura-Ryoko"
    ],
    "contact": {
        "homepage": "https://github.com/Kyoonit/litematica-enhanced",
        "issues": "https://github.com/Kyoonit/litematica-enhanced/issues",
        "sources": "https://github.com/Kyoonit/litematica-enhanced",
        "twitter": "https://twitter.com/maruohon",
        "discord": "https://discordapp.com/channels/211786369951989762/453662800460644354/"
    },
    "license": "LGPLv3",
    "icon": "assets/litematica/icon.png",

    "environment": "client",
    "entrypoints": {
        "main": [
            "fi.dy.masa.litematica.Litematica"
        ],
        "modmenu": [
            "fi.dy.masa.litematica.compat.modmenu.ModMenuImpl"
        ]
